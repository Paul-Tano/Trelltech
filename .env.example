# Copiez ce fichier en .env puis renseignez vos valeurs.
# Clé API de votre Power-Up Trello : https://trello.com/power-ups/admin
EXPO_PUBLIC_TRELLO_API_KEY=
# URL de retour après autorisation (doit être autorisée dans les "Allowed origins" du Power-Up).
# Exemple pour un build natif : trelltech://auth
EXPO_PUBLIC_TRELLO_REDIRECT_URI=
